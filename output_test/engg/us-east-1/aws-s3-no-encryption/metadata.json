{
  "policy": {
    "name": "aws-s3-no-encryption",
    "conditions": [
      {
        "region": "us-east-1"
      }
    ],
    "resource": "aws.s3",
    "description": "Notifies of S3 buckets without encyrption enabled\n",
    "mode": {
      "type": "periodic",
      "schedule": "cron(0, 23, ?, *, SUN, *)",
      "tags": {
        "contact": "ysrinu95@gmail.com",
