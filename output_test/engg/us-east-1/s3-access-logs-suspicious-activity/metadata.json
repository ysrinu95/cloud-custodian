{
  "policy": {
    "name": "s3-access-logs-suspicious-activity",
    "description": "Monitor S3 access logs for suspicious activity patterns.\nThis policy analyzes S3 access logs and triggers on anomalous access patterns.\n",
    "resource": "aws.s3",
    "mode": {
      "type": "cloudtrail",
      "events": [
        {
          "source": "s3.amazonaws.com",
          "event": "GetObject",
          "ids": "requestParameters.bucketName"
        },
        {
          "source": "s3.amazonaws.com",
          "event": "DeleteObject",
          "ids": "requestParameters.bucketName"
        },
        {
          "source": "s3.amazonaws.com",
          "event": "PutBucketPolicy",
          "ids": "requestParameters.bucketName"
        }
      ],
      "timeout": 300,
      "tags": {
        "contact": "srinivasula.yallala@optum.com",
        "repo": "aikyam-everything-as-code",
        "terraform": "True",
        "oid-owned": "True",
        "aide-id": "UHGWM110-019726",
        "service-tier": "p1",
        "application": "cloud-custodian",
        "managed-by": "jenkins",
        "environment": "engg",
        "component": "cloud-custodian-policy",
        "policy-type": "security-findings",
        "security-service": "s3-access-logs"
      }
    },
    "filters": [
      {
        "type": "bucket-logging",
        "op": "enabled"
      },
      {
        "type": "event",
        "key": "detail.requestParameters.key",
        "op": "regex",
        "value": ".*(password|secret|credential|key|token|private).*"
      },
      {
        "or": [
          {
            "type": "event",
            "key": "detail.sourceIPAddress",
            "op": "not-in",
            "value_from": {
              "url": "s3://your-config-bucket/trusted-ips.txt"
            }
          }
        ]
      }
    ],
    "actions": [
      {
        "type": "tag",
        "key": "SuspiciousAccess",
        "value": "Detected-{now:%Y-%m-%d}"
      },
      {
        "type": "toggle-versioning",
        "enabled": true
      },
      {
        "type": "notify",
        "template": "aws-basic-resource-names_slack",
        "priority_header": "2",
        "slack_template": "slack",
        "violation_desc": "Suspicious S3 Access Pattern Detected",
        "action_desc": "Suspicious access patterns detected in S3 access logs.\nThis may indicate unauthorized access or data exfiltration attempts.\n",
        "to": [
          "security-operations@optum.com",
          "slack://security-alerts"
        ],
        "transport": {
          "type": "sqs",
          "queue": "https://sqs.us-east-1.amazonaws.com/172327596604/custodian-mailer-queue"
        }
      }
    ]
  },
  "version": "0.9.47",
