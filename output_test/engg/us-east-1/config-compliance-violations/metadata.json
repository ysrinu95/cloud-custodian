{
  "policy": {
    "name": "config-compliance-violations",
    "description": "Respond to AWS Config rule compliance violations in real-time.\nThis policy triggers when resources become non-compliant with Config rules.\n",
    "resource": "aws.config-rule",
    "mode": {
      "type": "cloudtrail",
      "events": [
        {
          "source": "aws.config",
          "event": "PutEvaluations",
          "ids": "requestParameters.evaluations[].complianceResourceId"
        }
      ],
      "timeout": 300,
      "tags": {
        "contact": "srinivasula.yallala@optum.com",
        "repo": "aikyam-everything-as-code",
        "terraform": "True",
        "oid-owned": "True",
        "aide-id": "UHGWM110-019726",
        "service-tier": "p1",
        "application": "cloud-custodian",
        "managed-by": "jenkins",
        "environment": "engg",
        "component": "cloud-custodian-policy",
        "policy-type": "security-findings",
        "security-service": "config"
      }
    },
    "filters": [
      {
        "type": "value",
        "key": "compliance.ComplianceType",
        "value": "NON_COMPLIANT"
      },
      {
        "type": "value",
        "key": "ConfigRuleName",
        "op": "in",
        "value": [
          "encrypted-volumes",
          "s3-bucket-public-read-prohibited",
          "s3-bucket-public-write-prohibited",
          "iam-password-policy",
          "root-account-mfa-enabled",
          "restricted-ssh",
          "restricted-common-ports"
        ]
      }
    ],
    "actions": [
      {
        "type": "invoke-lambda",
        "function": "custodian-config-compliance-tagger",
        "async": true
      },
      {
        "type": "notify",
        "template": "aws-basic_email",
        "priority_header": "2",
        "violation_desc": "AWS Config Rule Compliance Violation",
        "action_desc": "A resource has become non-compliant with AWS Config rules.\nReview and remediate the compliance violation.\n",
        "to": [
          "compliance-team@optum.com"
        ],
        "transport": {
          "type": "sqs",
          "queue": "https://sqs.us-east-1.amazonaws.com/172327596604/custodian-mailer-queue"
        }
      }
    ]
  },
  "version": "0.9.47",
