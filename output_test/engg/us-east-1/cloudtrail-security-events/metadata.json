{
  "policy": {
    "name": "cloudtrail-security-events",
    "description": "Monitor AWS CloudTrail for high-risk security events and configuration changes.\nThis policy triggers on critical API calls that may indicate security issues.\n",
    "resource": "aws.account",
    "mode": {
      "type": "cloudtrail",
      "events": [
        {
          "source": "iam.amazonaws.com",
          "event": "DeleteUserPolicy",
          "ids": "requestParameters.userName"
        },
        {
          "source": "iam.amazonaws.com",
          "event": "PutUserPolicy",
          "ids": "requestParameters.userName"
        },
        {
          "source": "iam.amazonaws.com",
          "event": "AttachUserPolicy",
          "ids": "requestParameters.userName"
        },
        {
          "source": "iam.amazonaws.com",
          "event": "CreateAccessKey",
          "ids": "requestParameters.userName"
        },
        {
          "source": "iam.amazonaws.com",
          "event": "DeleteAccountPasswordPolicy",
          "ids": "userIdentity.accountId"
        },
        {
          "source": "guardduty.amazonaws.com",
          "event": "DeleteDetector",
          "ids": "requestParameters.detectorId"
        },
        {
          "source": "cloudtrail.amazonaws.com",
          "event": "StopLogging",
          "ids": "requestParameters.name"
        },
        {
          "source": "cloudtrail.amazonaws.com",
          "event": "DeleteTrail",
          "ids": "requestParameters.name"
        },
        {
          "source": "config.amazonaws.com",
          "event": "DeleteConfigRule",
          "ids": "requestParameters.configRuleName"
        },
        {
          "source": "config.amazonaws.com",
          "event": "StopConfigurationRecorder",
          "ids": "requestParameters.configurationRecorderName"
        },
        {
          "source": "ec2.amazonaws.com",
          "event": "AuthorizeSecurityGroupIngress",
          "ids": "requestParameters.groupId"
        },
        {
          "source": "ec2.amazonaws.com",
          "event": "CreateNetworkAclEntry",
          "ids": "requestParameters.networkAclId"
        },
        {
          "source": "signin.amazonaws.com",
          "event": "ConsoleLogin",
          "ids": "userIdentity.accountId"
        }
      ],
      "timeout": 300,
      "tags": {
        "contact": "srinivasula.yallala@optum.com",
        "repo": "aikyam-everything-as-code",
        "terraform": "True",
        "oid-owned": "True",
        "aide-id": "UHGWM110-019726",
        "service-tier": "p1",
        "application": "cloud-custodian",
        "managed-by": "jenkins",
        "environment": "engg",
        "component": "cloud-custodian-policy",
        "policy-type": "security-findings",
        "security-service": "cloudtrail"
      }
    },
    "filters": [
      {
        "or": [
          {
            "type": "event",
            "key": "detail.userIdentity.type",
            "value": "Root"
          },
          {
            "type": "event",
            "key": "detail.responseElements.ConsoleLogin",
            "value": "Failure"
          },
          {
            "type": "event",
            "key": "detail.awsRegion",
            "op": "not-in",
            "value": [
              "us-east-1",
              "us-east-2",
              "us-west-2"
            ]
          },
          {
            "and": [
              {
                "type": "event",
                "key": "detail.eventName",
                "value": "ConsoleLogin"
              },
              {
                "type": "event",
                "key": "detail.additionalEventData.MFAUsed",
                "value": "No"
              }
            ]
          }
        ]
      }
    ],
    "actions": [
      {
        "type": "notify",
        "template": "aws-account-root-user-login-detected_slack",
        "priority_header": "1",
        "slack_template": "slack",
        "violation_desc": "Critical CloudTrail Security Event Detected",
        "action_desc": "A critical security event has been detected in CloudTrail logs.\nThis may indicate:\n- Root account usage\n- Failed authentication attempts\n- Security service configuration changes\n- Unauthorized region access\n- Console login without MFA\n\nImmediate investigation required.\n",
        "to": [
          "security-operations@optum.com",
          "security-team@optum.com",
          "slack://critical-security-alerts"
        ],
        "transport": {
          "type": "sqs",
          "queue": "https://sqs.us-east-1.amazonaws.com/172327596604/custodian-mailer-queue"
        }
      }
    ]
  },
  "version": "0.9.47",
  "execution": {
    "id": "15feb435-9baf-4aa4-b585-9ee216ca3757",
    "start": 1761547693.2304797,
