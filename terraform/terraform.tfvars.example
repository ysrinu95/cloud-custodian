# Example terraform.tfvars file
# Copy this to terraform.tfvars and customize the values

# AWS Region where resources will be created
aws_region = "us-east-1"

# AWS Profile for local development (optional)
# aws_profile = "default"

# GitHub Actions Web Identity Role ARN for CI/CD (optional)
# github_actions_web_identity_role = "arn:aws:iam::123456789012:role/github-actions-role"

# GitHub repository in owner/repository format
github_repository = "ysrinu95/cloud-custodian"

# Name for the GitHub Actions IAM role
github_actions_role_name = "GitHubActions-CloudCustodian-Role"

# Environment (dev, staging, prod)
environment = "dev"

# Project name
project_name = "cloud-custodian"

# Enable enterprise features like SQS mailer queue, advanced logging, etc.
enable_enterprise_features = false

# Email address for SES identity and notifications (required if enterprise features enabled)
# notification_email = "alerts@yourcompany.com"