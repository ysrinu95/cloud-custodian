{
  "policy": {
    "name": "ec2-public-instance-stepfunction-periodic",
    "description": "Periodic scan for existing EC2 instances with public IP addresses.\nRuns hourly to catch instances that may have been missed by real-time detection\nor had their networking configuration changed after launch.\n",
    "resource": "aws.ec2",
    "mode": {
      "type": "periodic",
      "schedule": "rate(1 hour)",
      "role": "arn:aws:iam::172327596604:role/CloudCustodian-ExecutionRole",
      "tags": {
        "contact": "srinivasula.yallala@optum.com",
        "repo": "aikyam-everything-as-code",
        "terraform": "True",
        "oid-owned": "True",
        "aide-id": "UHGWM110-019726",
        "service-tier": "p1",
        "application": "cloud-custodian",
        "managed-by": "jenkins",
        "environment": "engg",
        "component": "cloud-custodian-policy",
        "policy-type": "security-findings",
        "security-service": "ec2-public-detection",
        "custodian-info": "mode=periodic:version=0.9.47"
      }
    },
    "filters": [
      {
        "type": "value",
        "key": "State.Name",
        "value": "running"
      },
      {
        "or": [
          {
            "type": "value",
            "key": "PublicIpAddress",
            "value": "not-null"
          },
          {
            "type": "value",
            "key": "NetworkInterfaces[].Association.PublicIp",
            "value": "not-null"
          }
        ]
      },
      {
        "type": "value",
        "key": "Tags[?Key == 'PublicInstanceApproved'] | length(@)",
        "value": 0
      },
      {
        "type": "value",
        "key": "Tags[?Key == 'SecurityFinding'] | length(@)",
        "value": 0
      }
    ],
    "actions": [
      {
        "type": "invoke-sfn",
        "state-machine": "arn:aws:states:us-east-1:{account}:stateMachine:EC2PublicInstanceRemediation"
      },
      {
        "type": "tag",
        "key": "SecurityFinding",
        "value": "PublicInstanceDetected"
      },
      {
        "type": "tag",
        "key": "DetectionSource",
        "value": "CloudCustodian-Periodic"
      },
      {
        "type": "tag",
        "key": "DetectionTime",
        "value": "{now:%Y-%m-%d %H:%M:%S UTC}"
      }
    ]
  },
  "version": "0.9.47",
  "execution": {
    "id": "8860d79d-401f-44a9-809a-ed4c5260163b",
    "start": 1761562668.1062024,
    "end_time": 1761562681.818002,
    "duration": 13.711799621582031
  },
  "config": {
    "region": "us-east-1",
    "regions": [
      "us-east-1"
    ],
    "cache": "~/.cache/cloud-custodian.cache",
