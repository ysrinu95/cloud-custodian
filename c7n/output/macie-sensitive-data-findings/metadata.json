{
  "policy": {
    "name": "macie-sensitive-data-findings",
    "description": "Respond to AWS Macie sensitive data discovery findings in S3 buckets.\nThis policy triggers when Macie detects PII, credentials, or sensitive data.\n",
    "resource": "aws.s3",
    "mode": {
      "type": "cloudtrail",
      "events": [
        {
          "source": "macie2.amazonaws.com",
          "event": "ClassificationResult",
          "ids": "detail.resourcesAffected.s3Bucket.name"
        }
      ],
      "role": "arn:aws:iam::172327596604:role/CloudCustodian-ExecutionRole",
      "timeout": 300,
      "tags": {
        "contact": "srinivasula.yallala@optum.com",
        "repo": "aikyam-everything-as-code",
        "terraform": "True",
        "oid-owned": "True",
        "aide-id": "UHGWM110-019726",
        "service-tier": "p1",
        "application": "cloud-custodian",
        "managed-by": "jenkins",
        "environment": "engg",
        "component": "cloud-custodian-policy",
        "policy-type": "security-findings",
        "security-service": "macie",
        "custodian-info": "mode=cloudtrail:version=0.9.47"
      }
    },
    "filters": [
      {
        "type": "event",
        "key": "detail.severity.score",
        "op": "gte",
        "value": 7
      }
    ],
    "actions": [
      {
        "type": "set-bucket-encryption",
        "crypto": "AES256"
      },
      {
        "type": "toggle-versioning",
        "enabled": true
      },
      {
        "type": "set-public-block",
        "BlockPublicAcls": true,
        "BlockPublicPolicy": true,
        "IgnorePublicAcls": true,
        "RestrictPublicBuckets": true
      },
      {
        "type": "tag",
        "key": "MacieFinding",
        "value": "SensitiveDataDetected"
      },
      {
        "type": "notify",
        "template": "aws-basic_email",
        "priority_header": "1",
        "violation_desc": "Macie Sensitive Data Finding",
        "action_desc": "AWS Macie has detected sensitive data (PII, credentials, financial info) in an S3 bucket.\nAutomatic remediation applied: encryption enabled, versioning enabled, public access blocked.\n",
        "to": [
          "data-security-team@optum.com",
          "compliance-team@optum.com"
        ],
        "transport": {
          "type": "sqs",
          "queue": "https://sqs.us-east-1.amazonaws.com/172327596604/custodian-mailer-queue"
        }
      }
    ]
  },
  "version": "0.9.47",
  "execution": {
    "id": "ddae3056-1ad3-41dc-965a-e0f02cdf3212",
    "start": 1761562598.9120243,
