    "profile": null,
    "account_id": "172327596604",
    "assume_role": "arn:aws:iam::172327596604:role/CloudCustodian-ExecutionRole",
    "session_policy": null,
    "external_id": null,
    "log_group": null,
    "tracer": "default",
