{
  "policy": {
    "name": "aws-cloudwatch-c7n-log-group-retention",
    "resource": "aws.log-group",
    "description": "Notifies and sets the log group retention for c7n log groups\n",
    "mode": {
      "type": "periodic",
      "schedule": "cron(0, 23, ?, *, SUN, *)",
      "tags": {
        "contact": "ysrinu95@gmail.com",
        "environment": "engg",
        "repo": "devops/cloud-custodian/c7n"
      }
    },
    "filters": [
      {
        "type": "value",
        "key": "logGroupName",
        "op": "regex",
        "value": "^/aws/lambda/custodian-"
      },
      {
        "retentionInDays": "absent"
      }
    ],
    "actions": [
      {
        "type": "retention",
        "days": 60
      },
      {
        "template": "aws-basic_email.html",
        "to": [
          "ysrinu95@gmail.com",
          "event-owner",
          "resource-owner"
        ],
        "transport": {
          "type": "sqs",
          "queue": "https://sqs.us-east-1.amazonaws.com/172327596604/custodian-mailer-queue"
        },
        "type": "notify",
        "subject": "[c7n] [{{ account }}] CloudWatch c7n Log Group Retention Updated ({{ region }})",
        "violation_desc": "c7n log groups with no retention set",
        "action_desc": "Log retention has been updated to 60 days.\n"
      }
    ]
  },
  "version": "0.9.47",
  "execution": {
    "id": "a7311739-3f12-4663-bcaa-65c79aaa5771",
    "start": 1761547883.0681257,
    "end_time": 1761547883.0681257,
    "duration": 0.0
  },
  "config": {
    "region": "us-east-1",
    "regions": [],
    "cache": "C:\\Users\\ysrin/.cache/c7n-org\\172327596604-us-east-1.cache",
    "profile": null,
    "account_id": "172327596604",
    "assume_role": "arn:aws:iam::172327596604:role/CloudCustodian-ExecutionRole",
    "session_policy": null,
    "external_id": null,
    "log_group": null,
    "tracer": "default",
    "metrics_enabled": false,
    "metrics": null,
    "output_dir": "output_test\\engg\\us-east-1",
    "cache_period": 15,
    "dryrun": true,
    "authorization_file": null
  },
