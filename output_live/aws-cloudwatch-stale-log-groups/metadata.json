{
  "policy": {
    "name": "aws-cloudwatch-stale-log-groups",
    "resource": "aws.log-group",
    "description": "Notifies of CloudWatch log groups found to be unused\n",
    "mode": {
      "type": "periodic",
      "schedule": "cron(0, 23, ?, *, SUN, *)",
      "role": "arn:aws:iam::172327596604:role/CloudCustodian-ExecutionRole",
      "tags": {
        "contact": "ysrinu95@gmail.com",
        "environment": "engg",
        "repo": "devops/cloud-custodian/c7n",
        "custodian-info": "mode=periodic:version=0.9.47"
      }
    },
    "filters": [
      {
        "type": "last-write",
        "days": 365
      },
      {
        "not": [
          {
            "type": "value",
            "key": "logGroupName",
            "op": "regex",
            "value": "^/aws/lambda/custodian-"
          }
        ]
      },
      {
        "tag:c7n-exception:unused": "absent"
      }
    ],
    "actions": [
      {
        "template": "aws-basic_email.html",
        "to": [
          "ysrinu95@gmail.com",
          "event-owner",
          "resource-owner"
        ],
        "transport": {
          "type": "sqs",
          "queue": "https://sqs.us-east-1.amazonaws.com/172327596604/custodian-mailer-queue"
        },
        "type": "notify",
        "subject": "[c7n] [{{ account }}] CloudWatch Log Groups Are Unused ({{ region }})",
        "violation_desc": "CloudWatch log groups not written to in the last year",
        "action_desc": "Please check the unused log groups and delete if unused\n"
      }
    ]
  },
  "version": "0.9.47",
  "execution": {
    "id": "7e68e98e-7d5e-49a1-8eeb-75852215aeb2",
    "start": 1761555044.2911563,
    "end_time": 1761555048.4677572,
    "duration": 4.176600933074951
  },
  "config": {
    "region": "us-east-1",
    "regions": [
      "us-east-1"
    ],
    "cache": "~/.cache/cloud-custodian.cache",
    "profile": null,
    "account_id": "172327596604",
    "assume_role": null,
    "session_policy": null,
    "external_id": null,
    "log_group": null,
    "tracer": null,
    "metrics_enabled": null,
    "metrics": null,
