    "duration": 3.8783910274505615
  },
  "config": {
    "region": "us-east-1",
    "regions": [
      "us-east-1"
    ],
    "cache": "~/.cache/cloud-custodian.cache",
    "profile": null,
    "account_id": "172327596604",
    "assume_role": null,
    "session_policy": null,
    "external_id": null,
    "log_group": null,
