{
  "policy": {
    "name": "aws-rds-engine-version-upgrade-available",
    "resource": "aws.rds",
    "description": "Notifies of RDS instances with engine upgrades available\n",
    "mode": {
      "type": "periodic",
      "schedule": "cron(0, 23, ?, *, SUN, *)",
      "role": "arn:aws:iam::172327596604:role/CloudCustodian-ExecutionRole",
      "tags": {
        "contact": "ysrinu95@gmail.com",
        "environment": "{environment}",
        "repo": "devops/cloud-custodian/c7n"
      }
    },
    "filters": [
      {
        "type": "upgrade-available",
        "major": true
      }
    ],
    "actions": [
      {
        "template": "aws-basic_email.html",
        "to": [
          "ysrinu95@gmail.com",
          "event-owner",
          "resource-owner"
        ],
        "transport": {
          "type": "sqs",
          "queue": "https://sqs.us-east-1.amazonaws.com/172327596604/custodian-mailer-queue"
        },
        "type": "notify",
        "subject": "[c7n] [{{ account }}] RDS Engine Upgrade Available ({{ region }})",
        "violation_desc": "RDS database engine upgrade available",
        "action_desc": "Please upgrade the database engine version.\n"
      }
    ]
  },
  "version": "0.9.47",
