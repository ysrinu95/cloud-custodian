{
  "policy": {
    "name": "aws-rds-snapshot-old",
    "resource": "rds-snapshot",
    "description": "Notifies of and deletes old RDS instance manual snapshots\n",
    "mode": {
      "type": "periodic",
      "schedule": "cron(0, 23, ?, *, SUN, *)",
      "role": "arn:aws:iam::172327596604:role/CloudCustodian-ExecutionRole",
      "tags": {
        "contact": "ysrinu95@gmail.com",
        "environment": "{environment}",
        "repo": "devops/cloud-custodian/c7n"
      }
    },
    "filters": [
      {
        "type": "value",
        "key": "SnapshotType",
        "value": "manual",
        "op": "eq"
      },
      {
        "type": "age",
        "days": 90,
        "op": "ge"
      },
      {
        "tag:c7n-exception:retention": "absent"
      }
    ],
    "actions": [
      "delete",
      {
        "template": "aws-basic_email.html",
        "to": [
          "ysrinu95@gmail.com",
          "event-owner",
          "resource-owner"
        ],
        "transport": {
          "type": "sqs",
          "queue": "https://sqs.us-east-1.amazonaws.com/172327596604/custodian-mailer-queue"
        },
        "type": "notify",
        "priority_header": 1,
        "subject": "[c7n] [{{ account }}] RDS Instance Snapshots older than 90 days ({{ region }})",
        "violation_desc": "RDS Snapshots older than 90 days",
        "action_desc": "Actions taken: RDS Instance Snapshots older than 90 days have been deleted. <br>\n"
      }
    ]
  },
  "version": "0.9.47",
  "execution": {
    "id": "c9f1937b-e14c-4cbe-96b6-4aebdc8185c2",
    "start": 1761554028.4361038,
    "end_time": 1761554030.193229,
    "duration": 1.7571251392364502
  },
  "config": {
    "region": "us-east-1",
    "regions": [
      "us-east-1"
    ],
    "cache": "~/.cache/cloud-custodian.cache",
    "profile": null,
