{
  "policy": {
    "name": "aws-s3-no-encryption",
    "conditions": [
      {
        "region": "us-east-1"
      }
    ],
    "resource": "aws.s3",
    "description": "Notifies of S3 buckets without encyrption enabled\n",
    "mode": {
      "type": "periodic",
      "schedule": "cron(0, 23, ?, *, SUN, *)",
      "role": "arn:aws:iam::172327596604:role/CloudCustodian-ExecutionRole",
      "tags": {
        "contact": "ysrinu95@gmail.com",
        "environment": "{environment}",
        "repo": "devops/cloud-custodian/c7n"
      }
    },
    "filters": [
      {
        "type": "bucket-encryption",
        "state": false
      }
    ],
    "actions": [
      {
        "template": "aws-basic_email.html",
        "to": [
          "ysrinu95@gmail.com",
          "event-owner",
          "resource-owner"
        ],
        "transport": {
          "type": "sqs",
          "queue": "https://sqs.us-east-1.amazonaws.com/172327596604/custodian-mailer-queue"
        },
        "type": "notify",
        "subject": "[c7n] [{{ account }}] S3 Buckets Without Encryption Report ({{ region }})",
        "violation_desc": "S3 buckets without encryption enabled",
        "action_desc": "No action taken. Encryption should be added to buckets.<br>\n<a href=\"https://docs.aws.amazon.com/AmazonS3/latest/userguide/bucket-encryption.html\">Documentation</a>\n"
      }
    ]
  },
