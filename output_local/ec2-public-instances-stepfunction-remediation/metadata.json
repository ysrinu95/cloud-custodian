{
  "policy": {
    "name": "ec2-public-instances-stepfunction-remediation",
    "description": "Detect public EC2 instances and invoke Step Function for automated remediation workflow.\nThis policy triggers a Step Function that handles notification, tagging, and remediation\nof publicly accessible EC2 instances.\n",
    "resource": "aws.ec2",
    "mode": {
      "type": "cloudtrail",
      "events": [
        "RunInstances"
      ],
      "role": "arn:aws:iam::172327596604:role/CloudCustodian-ExecutionRole"
    },
    "filters": [
      {
        "type": "value",
        "key": "State.Name",
        "value": "running"
      },
      {
        "type": "value",
        "key": "PublicIpAddress",
        "value": "not-null"
      }
    ],
    "actions": [
      {
        "type": "invoke-sfn",
        "state-machine": "arn:aws:states:us-east-1:172327596604:stateMachine:EC2PublicInstanceRemediation"
      }
    ]
  },
  "version": "0.9.47",
